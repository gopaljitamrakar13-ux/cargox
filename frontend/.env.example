# ==================================================
# CargoX Frontend — Environment Variables
# ==================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to Git.

# --------------------------------------------------
# Backend API URL
# --------------------------------------------------
# In development: leave empty or set to http://localhost:5000/api
#   (Vite proxy handles /api → localhost:5000 automatically)
# In production: set to your full Render backend URL + /api
#   e.g. VITE_API_URL=https://cargox-backend.onrender.com/api
VITE_API_URL=

# --------------------------------------------------
# Socket.IO URL (usually the backend without /api)
# --------------------------------------------------
# In development: http://localhost:5000
# In production:  https://cargox-backend.onrender.com
# If unset, it is derived from VITE_API_URL automatically.
VITE_SOCKET_URL=
