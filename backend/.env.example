# ==================================================
# CargoX Backend — Environment Variables
# ==================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to Git.

# --------------------------------------------------
# Flask Settings
# --------------------------------------------------
FLASK_ENV=development
FLASK_DEBUG=True

# --------------------------------------------------
# Database (PostgreSQL — REQUIRED)
# --------------------------------------------------
# Your external PostgreSQL connection string.
# Examples:
#   Local PostgreSQL:  postgresql://postgres:password@localhost:5432/cargox
#   Supabase:          postgresql://postgres:password@db.xxx.supabase.co:5432/postgres
#   Render DB:         postgresql://user:pass@host.render.com:5432/dbname
DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST:5432/DATABASE_NAME

# --------------------------------------------------
# Security Keys (change these in production!)
# --------------------------------------------------
SECRET_KEY=change-me-to-a-long-random-string
JWT_SECRET_KEY=change-me-to-another-long-random-string

# --------------------------------------------------
# CORS / Frontend URL
# --------------------------------------------------
# In development: your local Vite server
# In production:  your Render frontend URL
# Multiple origins: comma-separated
FRONTEND_URL=http://localhost:3000

# --------------------------------------------------
# Firebase (Optional)
# --------------------------------------------------
# Path to your Firebase Admin SDK JSON file.
# Leave empty to disable Firebase features.
# Do NOT commit the JSON file to Git.
FIREBASE_CREDENTIALS=

# --------------------------------------------------
# Server Port (Render sets this automatically)
# --------------------------------------------------
PORT=5000
